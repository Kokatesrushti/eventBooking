# Copy values into your host's env vars (Render dashboard) or export locally
DB_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DB_USER=
DB_PASSWORD=
JWT_SECRET=put-a-random-string-of-at-least-32-characters-here
APP_MODE=naive            # naive | optimized
DB_POOL_SIZE=10
VIRTUAL_THREADS=false
MAIL_PROVIDER=simulated   # simulated for load tests, resend for the real email demo
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_SIM_LATENCY_MS=300
SEED_ENABLED=true
SEED_SECRET=some-long-secret
